#!/usr/bin/env bash
# Wrapper pour lancer JPomodoro.
# Résout java + chemin du JAR de manière robuste.
#
# Variables d'environnement reconnues :
#   JPOMODORO_JAR     chemin alternatif du JAR (défaut : ../target/pomodoro.jar)
#   JAVA_HOME         JDK à utiliser (défaut : /opt/homebrew/opt/openjdk puis PATH)
#
# Notes :
# - Modèles Ollama : si stockés sur disque externe (ex: /Volumes/DD-2/ollama-models),
#   monter le disque avant lancement. Sinon l'IA sera désactivée à l'usage.
# - Lock file : ~/.pomodoro/.lock empêche les doubles instances.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="${JPOMODORO_JAR:-$SCRIPT_DIR/../target/pomodoro.jar}"

if [ ! -f "$JAR" ]; then
    echo "JPomodoro JAR introuvable : $JAR" >&2
    echo "Build : cd $(dirname "$SCRIPT_DIR") && mvn package -DskipTests" >&2
    exit 1
fi

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA="$JAVA_HOME/bin/java"
elif [ -x "/opt/homebrew/opt/openjdk@17/bin/java" ]; then
    JAVA="/opt/homebrew/opt/openjdk@17/bin/java"
elif [ -x "/opt/homebrew/opt/openjdk/bin/java" ]; then
    JAVA="/opt/homebrew/opt/openjdk/bin/java"
elif command -v java >/dev/null 2>&1; then
    JAVA="$(command -v java)"
else
    echo "Aucun Java trouvé. Installe OpenJDK 17+ (brew install openjdk@17)" >&2
    exit 1
fi

# Avertissement non-bloquant si symlink Ollama cassé (disque externe non monté)
OLLAMA_MODELS="$HOME/.ollama/models"
if [ -L "$OLLAMA_MODELS" ] && [ ! -d "$OLLAMA_MODELS" ]; then
    echo "⚠ Symlink Ollama cassé : $OLLAMA_MODELS" >&2
    echo "   Disque externe non monté ? IA sera indisponible. Continue quand même." >&2
fi

exec "$JAVA" -jar "$JAR" "$@"
